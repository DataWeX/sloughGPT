    "light": "  /* Light — warm cream paper with violet undertone */",
    "palettes": "/* Palettes — full-spectrum overrides applied via html class */",
    "doctrine": "/* Accent themes — the aura is the ACCENT layer and overrides ONLY\n   --primary/--ring on <html> (declared after the palettes at equal\n   specificity, so the chosen accent always wins). Everything else —\n   background, card, secondary, muted, border, input, charts, shadows —\n   belongs to the palette (or the noir-violet base). Auras must never set\n   surface tokens: doing so silently un-applies the selected palette (the\n   palette×aura cascade bug — palettes are full-spectrum only if their\n   surface tokens survive). */",
    "shadows": "/* Shadow design tokens — layered depth system */",
    "_auraLineWidth": 69
  }
