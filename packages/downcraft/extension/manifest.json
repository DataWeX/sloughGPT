{
  "manifest_version": 3,
  "name": "Downcraft Capture",
  "version": "1.0.0",
  "description": "Capture download links and send them to Downcraft",
  "permissions": ["downloads"],
  "host_permissions": ["http://localhost:*/*", "http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
