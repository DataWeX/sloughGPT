#!/usr/bin/env bash
# SloughGPT — single entry point for the app.
# For pip-installed users: `sloughgpt` console script (pyproject.toml) handles this.
set -e

# Resolve symlinks to find the actual repo root
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

# Resolve the project interpreter (SLO_PYTHON -> conda env sloughgpt ->
# .venv -> python3) instead of using bare python3, which lands in base
# conda and misses project-only packages like mogdb.
exec "$DIR/scripts/python" "$DIR/cli.py" "$@"
