#!/usr/bin/env bash
# SloughGPT — single entry point for the app.
# For pip-installed users: `sloughgpt` console script (pyproject.toml) handles this.
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"

PYTHON=python3
if [ -x "$DIR/.venv/bin/python" ]; then
    PYTHON="$DIR/.venv/bin/python"
fi

exec "$PYTHON" "$DIR/cli.py" "$@"
