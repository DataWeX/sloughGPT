# SloughGPT Production Environment
# Copy to .env.production and fill in values

# ── Domain ──────────────────────────────────────────────────────
# DOMAIN=localhost                          # Your domain (or localhost for local)
# PUBLIC_API_URL=https://$DOMAIN            # Public API URL for web UI
# NEXTAUTH_URL=https://$DOMAIN              # NextAuth callback URL

# ── Secrets (REQUIRED) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
SLO_JWT_SECRET=CHANGE_ME
SLO_API_KEY=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME

# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=sloughgpt
POSTGRES_USER=sloughgpt

# ── Model ───────────────────────────────────────────────────────
SLO_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
SLO_MODEL_DEVICE=cpu
SLO_MODEL_MAX_LENGTH=1024
SLO_MODEL_TEMPERATURE=0.7
SLO_MODEL_MAX_NEW_TOKENS=200
SLO_AUTOLOAD_MODEL=

# ── API Server ──────────────────────────────────────────────────
VERSION=latest
SLO_LOG_LEVEL=INFO
SLO_AUTH_REQUIRED=true
SLO_RATE_LIMIT_WINDOW=60
SLO_RATE_LIMIT_MAX=100
API_MEMORY_LIMIT=4G
API_CPU_LIMIT=2

# ── Nginx Ports ─────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Grafana ─────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
