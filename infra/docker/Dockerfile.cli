FROM python:3.12-slim

LABEL maintainer="SloughGPT"
LABEL description="SloughGPT CLI — interactive shell, multi-agent orchestration, training CLI"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/server/requirements.txt /tmp/requirements-api.txt
# torch is intentionally NOT installed here: requirements.txt line 4 keeps it
# optional (commented out), nothing on the CLI runtime path imports it
# (apps/api/server/version.py is try/except-guarded and reports "unknown"),
# and the only consumers are packages/core-py/scripts/benchmark_*.py, which
# this image never runs. Saves ~1 GB per image build.
RUN pip install --no-cache-dir -r /tmp/requirements-api.txt

COPY apps/cli /app/apps/cli
COPY apps/api/server /app/apps/api/server
COPY packages/core-py /app/packages/core-py
COPY packages/sdk-py /app/packages/sdk-py
COPY pyproject.toml README.md LICENSE /app/

RUN mkdir -p /app/data /app/models /app/datasets

ENV PYTHONPATH="/app:/app/packages/core-py:/app/apps/api/server"

CMD ["python", "/app/apps/cli/cli.py"]
