# SloughGPT Docker Environment
# Copy to .env and edit as needed.

# ── API Server ────────────────────────────────────────────────────
SLO_ENV=production
SLO_LOG_LEVEL=INFO
SLO_HOST=0.0.0.0
SLO_PORT=8000
SLO_AUTO_WORKFLOW=false

# ── Auth (disabled by default for local dev) ──────────────────────
SLO_AUTH_REQUIRED=false
# SLO_API_KEY=your-api-key-here
# SLO_JWT_SECRET=your-jwt-secret-here

# ── CORS (for reverse-proxy deployments) ──────────────────────────
# SLO_CORS_ORIGINS=https://app.example.com

# ── Model ─────────────────────────────────────────────────────────
# SLO_MODEL__NAME=Qwen/Qwen2.5-0.5B-Instruct
# SLO_MODEL__DEVICE=auto

# ── GPU (api-gpu profile) ────────────────────────────────────────
# CUDA_VISIBLE_DEVICES=0

# ── NextAuth (required for web service) ───────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

# ── Deployment ────────────────────────────────────────────────────
# REGISTRY=ghcr.io/your-org
# TAG=latest
# PULL=1
