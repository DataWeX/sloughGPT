{
  "name": "sloughgpt-monorepo",
  "private": true,
  "description": "Optional repo-root scripts; primary web app is apps/web.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/web",
    "packages/strui",
    "packages/sdk-ts/typescript-sdk",
    "packages/eslint-config"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "dev:stack": "./scripts/dev-stack.sh",
    "test:repo-root": "python3 -m pytest tests/test_repo_root_package_json.py -q",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "next": "^16.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
