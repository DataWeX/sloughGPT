{
  "name": "sloughgpt-web",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamtowbee/sloughGPT.git",
    "directory": "apps/web"
  },
  "homepage": "https://github.com/iamtowbee/sloughGPT/tree/main/apps/web",
  "bugs": {
    "url": "https://github.com/iamtowbee/sloughGPT/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist-vite",
    "dev": "vite",
    "dev:clean": "npm run clean && vite",
    "dev:restart": "lsof -ti :5173 | xargs kill -9 2>/dev/null; npm run dev",
    "build": "vite build",
    "build:vite": "NEXT_PUBLIC_API_URL= vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lib": "vitest run lib/",
    "test:components": "vitest run components/",
    "test:hooks": "vitest run hooks/",
    "test:changed": "vitest run --changed",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:vite": "start-server-and-test \"vite\" http://localhost:5173 \"cypress run\"",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ci:quick": "npm run typecheck && npm run test:lib && npm run test:components",
    "ci:e2e": "npm run build && npm run e2e:vite"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@react-three/fiber": "^9.8.2",
    "@sloughgpt/strui": "file:../../packages/strui",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.13",
    "recharts": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "v86": "^0.5.456",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.43",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.71",
    "autoprefixer": "^10.0.0",
    "cypress": "^14.0.0",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.0.0",
    "start-server-and-test": "^2.0.8",
    "tailwindcss": "^3.0.0",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
