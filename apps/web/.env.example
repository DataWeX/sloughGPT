# API base: none (same-origin, card 20261123_135845). The client sends
# root-relative requests; dev relays through vite (vite/api-relay-plugin →
# SLO_API_URL, default http://127.0.0.1:8000), the served site through the
# gateway. NEXT_PUBLIC_API_URL is retired — user define keys never applied
# under vite 8 dev and reached the browser raw.

# NextAuth — INERT. The Next scripts these vars served (`dev:e2e` on :3010,
# `build:export`) no longer exist, and `next-auth/react` resolves to the stub
# vite/next-compat/next-auth.tsx. Auth is FastAPI /auth/login.
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# GitHub OAuth — INERT for the same reason: the stub never reads these.
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret
