# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth — NEXT ALTERNATE PATH ONLY (npm run dev:e2e on :3010, npm run build:export).
# The live vite stack (:5173) does not serve /api/auth/* and ignores these; auth there
# is FastAPI /auth/login (via NEXT_PUBLIC_API_URL above).
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# GitHub OAuth — Next-path only (get from https://github.com/settings/developers)
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret
