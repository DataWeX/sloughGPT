# API base for the web client. The NEXT_PUBLIC_ prefix is historical: vite.config.ts
# defines `process.env.NEXT_PUBLIC_API_URL` from it (cypress.config.ts reads the same
# value via loadEnv), so the name is still the live contract, not a Next leftover.
#
# Single-origin dev: leave empty (or unset) so requests go to the current origin
# and Vite proxies backend paths to the Python API (see vite.config.ts server.proxy,
# target SLO_API_URL, default http://localhost:8000). Set a full URL to call a
# remote API directly and bypass proxy.
NEXT_PUBLIC_API_URL=

# NextAuth — INERT. The Next scripts these vars served (`dev:e2e` on :3010,
# `build:export`) no longer exist, and `next-auth/react` resolves to the stub
# vite/next-compat/next-auth.tsx. Auth is FastAPI /auth/login.
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# GitHub OAuth — INERT for the same reason: the stub never reads these.
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret
