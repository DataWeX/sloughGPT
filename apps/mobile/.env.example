# Sentry DSN (required for crash reporting and performance monitoring)
# Get from: https://sentry.io/settings/projects/sloughgpt-mobile/keys/
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# API URL (optional, defaults to http://localhost:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# App Environment (development, preview, production)
APP_ENV=development
