#!/bin/sh
# Project interpreter resolver.
#
#   scripts/python [args...]   run with the project interpreter
#   scripts/python --resolve   print the interpreter path instead
#
# Single authority: domain.shared.find_server_python (conda env `sloughgpt`
# -> .venv -> the interpreter doing the query). This wrapper only supplies
# what a shell needs — the SLO_PYTHON override, the repo root on PYTHONPATH
# (`domain` lives there and is not installed as a package), and a last-resort
# path scan for when Python itself is unavailable. Shell and Python can
# therefore never disagree about which interpreter is canonical.
#
# Override with SLO_PYTHON=/path/to/python.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Needed twice over: to import the resolver below, and by whatever we exec.
case ":${PYTHONPATH:-}:" in
  *":$ROOT:"*) ;;
  *) PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

# Repo packages must beat an installed site-packages snapshot (AGENTS
# one-shared-copy rule: the shared tree copy is the only copy). `downcraft`
# is pip-installed into the conda env as a Sep-18 snapshot whose "already
# downloaded" branch is unconditional, so without this entry `python -m
# downcraft` ran stale code: a dest missing from disk was reported as done,
# the reget fix (6c626f043) never fired, and e2e section 3 failed (card
# dd670ece). Only PYTHONPATH beats site-packages, so listing the repo path
# here is what makes the shared copy win.
#
# Deliberately narrow: only packages/ names that actually have an installed
# copy belong in this list. Adding the whole pytest.ini set would drag
# pytest-only entries (.pytest-libs, tests/api-server) into every invocation.
# tests/core-py/test_launcher_repo_copy.py ratchets it — it fails if any
# other packages/ name gains a site-packages copy and is not listed here.
case ":${PYTHONPATH:-}:" in
  *":$ROOT/packages/downcraft:"*) ;;
  *) PYTHONPATH="$ROOT/packages/downcraft${PYTHONPATH:+:$PYTHONPATH}" ;;
esac
export PYTHONPATH

# Only reached when no python could run the resolver at all.
_fallback() {
  for cand in \
    "${HOME}/miniconda3/envs/sloughgpt/bin/python" \
    "${HOME}/anaconda3/envs/sloughgpt/bin/python" \
    "${HOME}/miniforge3/envs/sloughgpt/bin/python" \
    "${HOME}/mambaforge/envs/sloughgpt/bin/python" \
    "/opt/conda/envs/sloughgpt/bin/python" \
    "$ROOT/.venv/bin/python3" \
    "$ROOT/.venv/bin/python"
  do
    [ -x "$cand" ] || continue
    printf '%s\n' "$cand"
    return 0
  done
  command -v python3
}

resolve() {
  if [ -n "${SLO_PYTHON:-}" ]; then
    printf '%s\n' "$SLO_PYTHON"
    return 0
  fi

  # Ask the Python-side resolver — the same authority app code consults.
  for py in python3 python; do
    command -v "$py" >/dev/null 2>&1 || continue
    resolved="$("$py" -c 'from domain.shared import find_server_python; print(find_server_python())' 2>/dev/null || true)"
    if [ -n "$resolved" ] && [ -x "$resolved" ]; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done

  _fallback
}

if [ "${1:-}" = "--resolve" ]; then
  resolve
else
  exec "$(resolve)" "$@"
fi
