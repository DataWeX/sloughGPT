#!/bin/sh
# Project interpreter resolver.
#
#   scripts/python [args...]   run with the project interpreter
#   scripts/python --resolve   print the interpreter path instead
#
# Single authority: domain.shared.find_server_python (conda env `sloughgpt`
# -> .venv -> the interpreter doing the query). This wrapper only supplies
# what a shell needs — the SLO_PYTHON override, the repo root on PYTHONPATH
# (`domain` lives there and is not installed as a package), and a last-resort
# path scan for when Python itself is unavailable. Shell and Python can
# therefore never disagree about which interpreter is canonical.
#
# Override with SLO_PYTHON=/path/to/python.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Needed twice over: to import the resolver below, and by whatever we exec.
case ":${PYTHONPATH:-}:" in
  *":$ROOT:"*) ;;
  *) PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

# Repo packages must beat two different things (AGENTS one-shared-copy rule:
# packages/* exists exactly once, in THIS working tree):
#   1. a pip-installed site-packages snapshot. `downcraft` was installed as a
#      Sep-18 copy whose "already downloaded" branch was unconditional, so
#      `python -m downcraft` ran stale code, reported success for a download
#      that wrote no file, and the reget fix (6c626f043) never fired
#      (card dd670ece).
#   2. the `sloughgpt` editable install, whose _EditableFinder MAPPING
#      hardcodes the MAIN TREE checkout. From any worktree that silently
#      resolves e.g. `mogdb` to the main tree's copy instead of the one you
#      are editing (card aecf2bb1). A PYTHONPATH entry outranks the finder.
#
# Each project root is listed explicitly — never bare $ROOT/packages, which is
# a PEP 420 namespace portion and loses to an installed regular package
# silently (a no-op that looks like a fix). Layout is detected per project:
# src-layout (packages/<n>/src) and flat (packages/<n>).
# Pure-shell basename: `$(basename …)` forks per project and added ~42ms to
# every invocation, which is more than the interpreter startup itself.
# tests/core-py/test_launcher_repo_copy.py ratchets the set: it fails if a
# repo package stops resolving from this tree.
for _proj in "$ROOT"/packages/*/; do
  _path="${_proj%/}"
  _name="${_path##*/}"
  if [ -d "$_path/src/$_name" ]; then
    _path="$_path/src"
  elif [ ! -d "$_path/$_name" ]; then
    continue
  fi
  case ":${PYTHONPATH:-}:" in
    *":$_path:"*) ;;
    *) PYTHONPATH="$_path${PYTHONPATH:+:$PYTHONPATH}" ;;
  esac
done
export PYTHONPATH

# Only reached when no python could run the resolver at all.
_fallback() {
  for cand in \
    "${HOME}/miniconda3/envs/sloughgpt/bin/python" \
    "${HOME}/anaconda3/envs/sloughgpt/bin/python" \
    "${HOME}/miniforge3/envs/sloughgpt/bin/python" \
    "${HOME}/mambaforge/envs/sloughgpt/bin/python" \
    "/opt/conda/envs/sloughgpt/bin/python" \
    "$ROOT/.venv/bin/python3" \
    "$ROOT/.venv/bin/python"
  do
    [ -x "$cand" ] || continue
    printf '%s\n' "$cand"
    return 0
  done
  command -v python3
}

resolve() {
  if [ -n "${SLO_PYTHON:-}" ]; then
    printf '%s\n' "$SLO_PYTHON"
    return 0
  fi

  # Ask the Python-side resolver — the same authority app code consults.
  for py in python3 python; do
    command -v "$py" >/dev/null 2>&1 || continue
    resolved="$("$py" -c 'from domain.shared import find_server_python; print(find_server_python())' 2>/dev/null || true)"
    if [ -n "$resolved" ] && [ -x "$resolved" ]; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done

  _fallback
}

if [ "${1:-}" = "--resolve" ]; then
  resolve
else
  exec "$(resolve)" "$@"
fi
