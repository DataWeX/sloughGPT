# Init
CONFIG_INIT=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_SYSLOG=y
CONFIG_FEATURE_INIT_TERMINAL_TYPE=y
CONFIG_FEATURE_INIT_MDEV=y
CONFIG_FEATURE_INIT_MDEV_LOG=y

# Login/Password
CONFIG_LOGIN=y
CONFIG_SULOGIN=y
CONFIG_PASSWD=y
CONFIG_ADDUSER=y
CONFIG_ADDGROUP=y
