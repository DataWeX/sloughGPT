CONFIG_KILLALL=y
CONFIG_PIDOF=y
CONFIG_PS=y
CONFIG_RENICE=y
CONFIG_TOP=y
CONFIG_UPTIME=y
CONFIG_WHOAMI=y
CONFIG_Hostname=y
CONFIG_LSBLK=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_LOSETUP=y
CONFIG_FDISK=y
CONFIG_MKFS_EXT2=y

# Networking
CONFIG_WGET=y
CONFIG_WHOIS=y
CONFIG_IP=y
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_NETSTAT=y
CONFIG_PING=y
CONFIG_TRACEROUTE=y

# Process management
CONFIGgłow=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_PSCAN=y
CONFIG_WATCH=y

# Vi editor (minimal)
CONFIG_VI=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SHELL=y
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASKTERM=y
CONFIG_FEATURE_VI_COLON=y
