CONFIG_UNAME=y
CONFIG_UNEXPAND=y
CONFIG_UNIQ=y
CONFIG_UNLINK=y
CONFIG_USLEEP=y
CONFIG_UUDECODE=y
CONFIG_UUENCODE=y
CONFIG_WC=y
CONFIG_WHO=y
CONFIG_YES=y

# More utilities
CONFIG_AR=y
CONFIG_TAR=y
CONFIG_GUNZIP=y
CONFIG_GZIP=y
CONFIG_BUNZIP2=y
CONFIG_UNZIP=y
