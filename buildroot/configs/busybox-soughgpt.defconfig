CONFIG_DELGROUP=y
CONFIG_GETTY=y

# Cron
CONFIG_CROND=y
CONFIG_CRONTAB=y

# Logs
CONFIG_SYSLOGD=y
CONFIG_FEATURE_SYSLOGD_READ_BUFFER_SIZE=1024
CONFIG_FEATURE_SYSLOGD_CFG=y
CONFIG_FEATURE_SYSLOGD_DUP=y
