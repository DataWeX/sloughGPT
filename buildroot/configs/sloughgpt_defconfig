#
# SloughGPT Buildroot Defconfig
# Minimal x86_64 image for v86 browser VM
#

# Architecture
BR2_x86_64=y
BR2_ARCH="x86_64"
BR2_TARGET_ARCH="x86_64"

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_VERSION="12.3.0"
BR2_TOOLCHAIN_BUILDROOT_GCC_VERSION="13.2.0"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1.73"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="configs/linux-soughgpt.defconfig"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_HOST_LINUX_HEADERS=y

# Bootloader
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_DISK="hd0,0"
BR2_TARGET_GRUB2_BOOTLOADER_MODULES="part_msdos ext2 normal"

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"

# BusyBox
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="configs/busybox-soughgpt.defconfig"
BR2_PACKAGE_BUSYBOX_INSTALL_IN_HOST=y

# Core packages
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_CPIO=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_XZ=y

# System
BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_DBUS=y

# Python (optional, for Dait shell integration)
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y

# Networking (minimal)
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPTABLES=y

# Shell
BR2_PACKAGE_BASH_COMPLETION=y

# Root filesystem overlay
BR2_ROOTFS_OVERLAY="board/soughgpt/overlay"

# Post-build and post-image scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="post-image.sh"

# Debug
BR2_ENABLE_DEBUG=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_STRACE=y

# Image format
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
