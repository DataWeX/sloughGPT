# SloughGPT — Environment Variables
# Copy to .env and uncomment the ones you need.
# Canonical prefix: SLO_* (legacy SLAUGHGPT_* still accepted as fallback).

# ── Server ────────────────────────────────────────────────────────
# SLO_HOST=0.0.0.0
# SLO_PORT=8000
# SLO_LOG_LEVEL=INFO
# SLO_ENV=production            # development | production
# SLO_RELOAD=false              # hot-reload on code changes (dev only)
# SLO_REQUEST_TIMEOUT=60.0      # per-request timeout in seconds
# SLO_INFERENCE_POOL_SIZE=2     # max concurrent inference workers

# ── Model ─────────────────────────────────────────────────────────
# SLO_MODEL__NAME=Qwen/Qwen2.5-0.5B-Instruct
# SLO_MODEL__DEVICE=auto        # auto | cpu | cuda | mps
# SLO_MODEL__MAX_LENGTH=1024
# SLO_MODEL__TEMPERATURE=0.7
# SLO_MODEL__TOP_P=0.9
# SLO_MODEL__TOP_K=50
# SLO_MODEL__REPETITION_PENALTY=1.1
# SLO_MODEL__MAX_NEW_TOKENS=200
# SLO_AUTOLOAD_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# SLO_AUTOLOAD_DEVICE=cpu
# SLO_USE_SLONET=false

# ── Auth ──────────────────────────────────────────────────────────
# SLO_AUTH_REQUIRED=false       # require JWT on sensitive endpoints
# SLO_API_KEY=                  # primary API key (auto-generated if empty)
# SLO_API_KEYS=                 # comma-separated additional keys
# SLO_JWT_SECRET=               # JWT signing secret (auto-generated if empty)
# SLO_JWT_EXPIRATION_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────
# SLO_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────
# SLO_RATE_LIMIT__WINDOW_SECONDS=60
# SLO_RATE_LIMIT__MAX_REQUESTS=100
# SLO_RATE_LIMIT__BURST_MULTIPLIER=1.5

# ── Features ──────────────────────────────────────────────────────
# SLO_AUTO_WORKFLOW=false       # auto-feedback workflow
# SLO_HEALTH_MONITOR=true       # background health checker
# SLO_WATCHDOG=true             # process watchdog (restart on crash)
# SLO_WEB=false                 # enable web UI serving

# ── Storage ───────────────────────────────────────────────────────
# SLO_STORAGE__DATA_DIR=data
# SLO_STORAGE__DATASETS_DIR=datasets
# SLO_STORAGE__MODELS_DIR=models
# SLO_STORAGE__CHECKPOINT_DIR=models/auto-training

# ── Embedding ─────────────────────────────────────────────────────
# SLO_EMBEDDING__PROVIDER=n_gram    # n_gram | openai
# SLO_EMBEDDING__OPENAI_API_KEY=

# ── Tracking ──────────────────────────────────────────────────────
# SLO_TRACKING__PROVIDER=none       # none | wandb | mlflow
# SLO_TRACKING__WANDB_API_KEY=
# SLO_TRACKING__WANDB_PROJECT=sloughgpt

# ── Process Guard (optional) ──────────────────────────────────────
# SLO_ENABLE_PROCESS_GUARD=false
# SLO_GUARD_MEMORY_LIMIT_MB=2048
# SLO_GUARD_MAX_RESTARTS=3
# SLO_GUARD_RESTART_DELAY=5

# ── Docker ────────────────────────────────────────────────────────
# COMPOSE_PROJECT_NAME=sloughgpt
